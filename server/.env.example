# Bharat Chat Server Environment Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Leave empty or uncomment to use embedded Postgres)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/bharatchat

# JWT Secrets (Generate secure random 64-char strings for production)
JWT_ACCESS_SECRET=bharat_chat_access_secret_super_secure_key_12345
JWT_REFRESH_SECRET=bharat_chat_refresh_secret_super_secure_key_67890
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Media Upload Directory
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://bharatchat.in

# WebRTC STUN Servers (comma separated)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
